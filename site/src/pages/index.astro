---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Personal details (defined here, rendered as HTML below).
const name = 'Krunal';
const role = 'Cyber Security Consultant';
const location = 'Regina, Saskatchewan';
const focusAreas = ['Microsoft Purview', 'Sentinel', 'Defender XDR', 'Entra ID'];
const yearsExperience = '9+';

// Professional bio, rendered as HTML in the About section below.
const bioLead =
  'Microsoft 365 security consultant with 9+ years of client delivery across government, utility, and regulated enterprise environments.';
const bioBody =
  'My hands-on work covers the full E5 security stack, including Purview information protection, DLP and insider risk, the Defender family, Sentinel, Entra ID with Conditional Access and PIM, plus Intune and SCCM. I stay with an engagement the whole way, from the first assessment through design, phased rollout, testing, and handover.';

// Only the Purview scenario library is published to this site.
const scenarios = await getCollection('scenarios');

const areas = new Map<string, { label: string; count: number }>();
for (const s of scenarios) {
  const cur = areas.get(s.data.categorySlug) ?? { label: s.data.category, count: 0 };
  cur.count += 1;
  areas.set(s.data.categorySlug, cur);
}
const areaList = [...areas.entries()]
  .map(([slug, v]) => ({ slug, ...v }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
---

<Base
  title={`${name} · ${role}`}
  description={`${name}, ${role} in ${location}. A growing library of production-ready Microsoft Purview and security scenarios: ${focusAreas.join(', ')}.`}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Microsoft Purview · Security &amp; Compliance</p>
      <h1>{name}</h1>
      <p class="role">{role}</p>
      <p class="location">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
          ></path></svg
        >
        {location}
      </p>

      <p class="lead">
        A growing, hands-on library of production-ready Microsoft Purview scenarios. Every one is
        taken from start to finish, covering the business driver, architecture, deployment,
        validation, and rollback.
      </p>

      <ul class="chips" aria-label="Focus areas">
        {focusAreas.map((area) => <li>{area}</li>)}
      </ul>

      <div class="cta">
        <a class="btn btn-primary" href="/scenarios/">Explore the library →</a>
        <a
          class="btn btn-ghost"
          href="https://github.com/kpsec1/purview-scenario-library"
          rel="noopener"
          target="_blank">View source on GitHub</a
        >
      </div>
    </div>
  </section>

  <section class="wrap stats-wrap">
    <div class="stats">
      <div class="stat">
        <span class="num">{yearsExperience}</span>
        <span class="lbl">Years of client delivery</span>
      </div>
      <div class="stat">
        <span class="num">{scenarios.length}</span>
        <span class="lbl">Documented scenarios</span>
      </div>
      <div class="stat">
        <span class="num">{areaList.length}</span>
        <span class="lbl">Purview solution areas</span>
      </div>
      <div class="stat">
        <span class="num">4</span>
        <span class="lbl">Docs per scenario: design, deploy, validate, rollback</span>
      </div>
    </div>
  </section>

  <section class="wrap about" aria-labelledby="about-heading">
    <div class="about-card">
      <span class="about-kicker">About</span>
      <h2 id="about-heading">{bioLead}</h2>
      <p>{bioBody}</p>
      <ul class="about-tags" aria-label="Platforms">
        <li>Microsoft E5 security</li>
        <li>Purview</li>
        <li>Defender XDR</li>
        <li>Sentinel</li>
        <li>Entra ID · CA · PIM</li>
        <li>Intune · SCCM</li>
      </ul>
    </div>
  </section>

  <section class="wrap areas-section">
    <div class="section-head">
      <h2>What's inside</h2>
      <a href="/scenarios/">All scenarios →</a>
    </div>
    <div class="area-grid">
      {
        areaList.map((a) => (
          <a class="area-card" href={`/scenarios/#${a.slug}`}>
            <span class="area-name">{a.label}</span>
            <span class="area-count">{a.count} {a.count === 1 ? 'scenario' : 'scenarios'}</span>
          </a>
        ))
      }
    </div>
    <p class="roadmap">
      <strong>This library keeps growing.</strong> I add new Microsoft Purview use cases regularly,
      along with scenarios that reach into the wider Microsoft security and compliance stack.
    </p>
  </section>

  <style>
    .hero {
      background:
        radial-gradient(120% 120% at 100% 0%, var(--bg-tint) 0%, transparent 55%),
        linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
      border-bottom: 1px solid var(--border);
      padding: 64px 0 56px;
    }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--accent);
      margin: 0 0 14px;
    }
    h1 {
      font-size: clamp(2.6rem, 7vw, 4rem);
      font-weight: 900;
      margin: 0;
    }
    .role {
      font-size: clamp(1.15rem, 3vw, 1.4rem);
      font-weight: 700;
      color: var(--accent-ink);
      margin: 6px 0 6px;
    }
    .location {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 15px;
      margin: 0 0 24px;
    }
    .lead {
      max-width: 62ch;
      font-size: clamp(1.05rem, 2.4vw, 1.22rem);
      color: var(--body);
      margin: 0 0 26px;
    }
    .chips {
      list-style: none;
      padding: 0;
      margin: 0 0 34px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .chips li {
      background: #fff;
      border: 1px solid var(--border-strong);
      border-radius: 999px;
      padding: 7px 15px;
      font-weight: 600;
      font-size: 14.5px;
      color: var(--ink);
      box-shadow: var(--shadow);
    }
    .cta {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .btn {
      display: inline-block;
      padding: 13px 22px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 15.5px;
    }
    .btn:hover {
      text-decoration: none;
    }
    .btn-primary {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 6px 18px rgba(29, 78, 216, 0.28);
    }
    .btn-primary:hover {
      filter: brightness(1.06);
    }
    .btn-ghost {
      background: #fff;
      color: var(--ink);
      border: 1px solid var(--border-strong);
    }

    .stats-wrap {
      margin-top: -28px;
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
    }
    .stat {
      background: #fff;
      padding: 22px 20px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .stat .num {
      font-size: 2.1rem;
      font-weight: 900;
      color: var(--accent-ink);
      letter-spacing: -0.03em;
      line-height: 1;
    }
    .stat .lbl {
      font-size: 13.5px;
      color: var(--muted);
      font-weight: 500;
    }

    .about {
      margin-top: 56px;
    }
    .about-card {
      position: relative;
      background: #fff;
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius);
      padding: 30px 32px;
      box-shadow: var(--shadow);
    }
    .about-kicker {
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 12px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 12px;
    }
    .about-card h2 {
      font-size: clamp(1.25rem, 2.6vw, 1.6rem);
      line-height: 1.35;
      margin: 0 0 14px;
      max-width: 46ch;
    }
    .about-card p {
      color: var(--body);
      font-size: 1.05rem;
      margin: 0 0 20px;
      max-width: 68ch;
    }
    .about-tags {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .about-tags li {
      font-size: 13px;
      font-weight: 600;
      color: var(--accent-ink);
      background: var(--bg-tint);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 5px 12px;
    }

    .areas-section {
      margin-top: 64px;
    }
    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }
    .section-head h2 {
      font-size: 1.6rem;
      margin: 0;
    }
    .section-head a {
      font-weight: 600;
      font-size: 15px;
      white-space: nowrap;
    }
    .area-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
    }
    .area-card {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 18px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }
    .area-card:hover {
      text-decoration: none;
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
    .area-name {
      font-weight: 700;
      color: var(--ink);
    }
    .area-count {
      font-size: 13.5px;
      color: var(--muted);
    }
    .roadmap {
      margin-top: 28px;
      padding: 18px 22px;
      background: var(--bg-tint);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--ink);
      font-size: 15.5px;
    }

    @media (max-width: 820px) {
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .hero {
        padding: 44px 0 40px;
      }
      .about-card {
        padding: 24px 22px;
      }
    }
    @media (max-width: 460px) {
      .stats {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
