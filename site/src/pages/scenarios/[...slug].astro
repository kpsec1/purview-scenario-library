---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Code } from 'astro:components';
import themes from '../../data/themes.json';
import flagship from '../../data/flagship.json';

// Structured deploy/validate scripts, generated by sync-scenarios.mjs.
interface Script {
  path: string;
  lang: string;
  code: string;
}
const scriptModules = import.meta.glob('/src/data/scenario-scripts/**/*.json', { eager: true });
const scriptsById: Record<string, { deploy: Script[]; validate: Script[] }> = {};
for (const [file, mod] of Object.entries(scriptModules)) {
  const id = file.replace('/src/data/scenario-scripts/', '').replace(/\.json$/, '');
  scriptsById[id] = (mod as any).default ?? mod;
}

export async function getStaticPaths() {
  const isNote = (e: { id: string }) => !e.id.split('/').pop()!.includes('.');
  const all = await getCollection('scenarios');
  const notes = all.filter(isNote);

  const partsByParent = new Map<string, Record<string, (typeof all)[number]>>();
  for (const e of all) {
    if (e.data.part && e.data.parent) {
      const bucket = partsByParent.get(e.data.parent) ?? {};
      bucket[e.data.part] = e;
      partsByParent.set(e.data.parent, bucket);
    }
  }

  return notes.map((entry) => {
    // "Keep reading": up to three other notes from the same story, same area first.
    const keepReading = notes
      .filter((n) => n.id !== entry.id && n.data.theme === entry.data.theme)
      .sort(
        (a, b) =>
          Number(b.data.categorySlug === entry.data.categorySlug) -
            Number(a.data.categorySlug === entry.data.categorySlug) ||
          a.data.title!.localeCompare(b.data.title!)
      )
      .slice(0, 3)
      .map((n) => ({ id: n.id, title: n.data.title, teaser: n.data.teaser, minutes: n.data.readingMinutes }));
    return {
      params: { slug: entry.id },
      props: { entry, parts: partsByParent.get(entry.id) ?? {}, keepReading },
    };
  });
}

const { entry, parts, keepReading } = Astro.props;
const data = entry.data;
const theme = themes.find((t) => t.slug === data.theme);
const themeTitle = theme?.title ?? 'Field notes';

const { Content: StoryContent } = await render(entry);
const RunbookContent = parts.runbook ? (await render(parts.runbook)).Content : null;
const DesignContent = parts.design ? (await render(parts.design)).Content : null;
const RollbackContent = parts.rollback ? (await render(parts.rollback)).Content : null;

const scripts = scriptsById[entry.id] ?? { deploy: [], validate: [] };
const shikiLang = (l: string) => (l === 'text' ? 'plaintext' : l);

// Flagship openings are drafts until the author approves them.
const posts = flagship.posts as Record<string, any>;
const draft = posts[entry.id];
const showDrafts = process.env.SHOW_FLAGSHIP_DRAFTS === '1';
const flagshipLive = Boolean(draft) && (showDrafts || (draft.published ?? flagship.published));
const dek = flagshipLive && draft.dek ? draft.dek : data.teaser;

const toc = [...(data.toc ?? [])];
if (data.hasRunbook || scripts.deploy.length || DesignContent || RollbackContent) {
  toc.push({ id: 'runbook', text: 'The Runbook' });
}

// The one-minute briefing: only facts we can state reliably.
const briefing: { label: string; value: string }[] = [];
if (data.whoFor) briefing.push({ label: 'Who it is for', value: data.whoFor });
if (data.frameworks?.length) briefing.push({ label: 'Frameworks referenced', value: data.frameworks.join(', ') });
if (data.licensing?.length) briefing.push({ label: 'Licensing referenced', value: data.licensing.join(', ') });
if (data.deployCount || data.validateCount) {
  const bits: string[] = [];
  if (data.deployCount) bits.push(`${data.deployCount} deployment script${data.deployCount === 1 ? '' : 's'}`);
  if (data.validateCount) bits.push(`${data.validateCount} validation check${data.validateCount === 1 ? '' : 's'}`);
  briefing.push({ label: 'What you deploy', value: bits.join(' and ') });
}
if (data.hasRollback) briefing.push({ label: 'Reversible', value: 'Yes, a rollback runbook is included' });
---

<Base title={`${data.title} · ${themeTitle}`} description={dek ?? data.title}>
  <header class="post-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/scenarios/">Field Notes</a>
        <span>/</span>
        <a href={`/scenarios/#${data.theme}`}>{themeTitle}</a>
      </nav>
      <p class="kicker">{themeTitle} · {data.category}</p>
      <h1>{data.title}</h1>
      {dek && <p class="dek">{dek}</p>}
      <p class="byline">
        <span>By Krunal</span>
        <span>{data.readingMinutes} min read</span>
        {data.hasRunbook && <span>Runbook included</span>}
      </p>
    </div>
  </header>

  <div class="wrap post-layout">
    <article class="post-main">
      {
        flagshipLive && draft.opening && (
          <section class="opening" aria-label="Opening">
            {draft.opening.map((p: string, i: number) => (
              <p class:list={{ 'opening-lede': i === 0 }}>{p}</p>
            ))}
            {draft.pull && <blockquote class="pull">{draft.pull}</blockquote>}
          </section>
        )
      }

      {
        briefing.length > 0 && (
          <section class="briefing" aria-label="The one-minute briefing">
            <h2 class="briefing-title">The one-minute briefing</h2>
            <dl>
              {briefing.map((b) => (
                <div class="brief-row">
                  <dt>{b.label}</dt>
                  <dd>{b.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <details class="toc-mobile">
        <summary>On this page</summary>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
        </ol>
      </details>

      <div class="prose story">
        <StoryContent />
      </div>

      {
        toc.some((t) => t.id === 'runbook') && (
          <section class="runbook" id="runbook">
            <div class="runbook-intro">
              <p class="kicker">For the people doing the work</p>
              <h2>The Runbook</h2>
              <p>
                Everything an engineer needs to run this in a tenant: implementation steps, configuration,
                operations, scripts, design notes and rollback. If you only need the story, you can stop
                reading here.
              </p>
            </div>

            <details class="runbook-toggle">
              <summary>
                <span class="rb-title">Open the runbook</span>
                <span class="rb-sub">
                  Steps, configuration, {scripts.deploy.length + scripts.validate.length} script{
                    scripts.deploy.length + scripts.validate.length === 1 ? '' : 's'
                  }, design notes, rollback
                </span>
              </summary>

              <div class="runbook-body">
                {
                  RunbookContent && (
                    <div class="prose">
                      <RunbookContent />
                    </div>
                  )
                }

                {
                  scripts.deploy.length > 0 && (
                    <div class="artifact" id="deployment-scripts">
                      <h3>Deployment scripts</h3>
                      <p class="artifact-note">
                        Review each file, then run in order. Expand to read, and use Copy to take the full script.
                      </p>
                      {scripts.deploy.map((s) => (
                        <details class="script">
                          <summary>
                            <span class="script-file">{s.path}</span>
                            <span class="script-lang">{s.lang}</span>
                          </summary>
                          <div class="script-body">
                            <button class="copy-btn" type="button">Copy</button>
                            <Code code={s.code} lang={shikiLang(s.lang) as any} theme="github-light" />
                          </div>
                        </details>
                      ))}
                    </div>
                  )
                }

                {
                  scripts.validate.length > 0 && (
                    <div class="artifact" id="validation-scripts">
                      <h3>Validation scripts</h3>
                      <p class="artifact-note">Run these after deployment to confirm the control works as designed.</p>
                      {scripts.validate.map((s) => (
                        <details class="script">
                          <summary>
                            <span class="script-file">{s.path}</span>
                            <span class="script-lang">{s.lang}</span>
                          </summary>
                          <div class="script-body">
                            <button class="copy-btn" type="button">Copy</button>
                            <Code code={s.code} lang={shikiLang(s.lang) as any} theme="github-light" />
                          </div>
                        </details>
                      ))}
                    </div>
                  )
                }

                {
                  DesignContent && (
                    <div class="artifact" id="design-notes">
                      <h3>Design notes</h3>
                      <details class="longform">
                        <summary>Read the design notes</summary>
                        <div class="prose">
                          <DesignContent />
                        </div>
                      </details>
                    </div>
                  )
                }

                {
                  RollbackContent && (
                    <div class="artifact" id="rollback-runbook">
                      <h3>Rollback runbook</h3>
                      <details class="longform">
                        <summary>Read the rollback runbook</summary>
                        <div class="prose">
                          <RollbackContent />
                        </div>
                      </details>
                    </div>
                  )
                }
              </div>
            </details>
          </section>
        )
      }

      {
        keepReading.length > 0 && (
          <section class="keep" aria-labelledby="keep-h">
            <p class="kicker">Keep reading</p>
            <h2 id="keep-h">More from “{themeTitle}”</h2>
            <div class="keep-grid">
              {keepReading.map((k) => (
                <a class="keep-card" href={`/scenarios/${k.id}/`}>
                  <span class="keep-title">{k.title}</span>
                  <span class="keep-text">{k.teaser}</span>
                  <span class="keep-meta">{k.minutes} min read</span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </article>

    <aside class="toc-desktop" aria-label="On this page">
      <nav>
        <p class="toc-head">On this page</p>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
        </ol>
      </nav>
    </aside>
  </div>

  <script>
    // Copy buttons on script blocks.
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const pre = btn.parentElement?.querySelector('pre');
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.innerText);
          const prev = btn.textContent;
          btn.textContent = 'Copied';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = prev;
            btn.classList.remove('copied');
          }, 1400);
        } catch {
          btn.textContent = 'Copy failed';
          setTimeout(() => (btn.textContent = 'Copy'), 1400);
        }
      });
    });

    // A link that points inside a closed section opens the section first.
    const openAround = (id: string) => {
      const el = id ? document.getElementById(id) : null;
      if (!el) return;
      let node: HTMLElement | null = el;
      while (node) {
        if (node instanceof HTMLDetailsElement) node.open = true;
        node = node.parentElement;
      }
      if (id === 'runbook') {
        const rb = el.querySelector<HTMLDetailsElement>('.runbook-toggle');
        if (rb) rb.open = true;
      }
      el.scrollIntoView({ block: 'start' });
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
      a.addEventListener('click', () => openAround(a.getAttribute('href')!.slice(1)))
    );
    if (location.hash) openAround(location.hash.slice(1));
  </script>

  <style>
    .post-head {
      border-bottom: 1px solid var(--rule);
      padding: 52px 0 40px;
      background:
        radial-gradient(50% 100% at 100% 0%, var(--accent-soft) 0%, transparent 60%),
        var(--paper);
    }
    .crumbs {
      font-size: 13.5px;
      color: var(--muted);
      margin-bottom: 18px;
    }
    .crumbs span {
      margin: 0 8px;
      color: var(--rule-strong);
    }
    .post-head h1 {
      font-size: clamp(2.1rem, 5vw, 3.6rem);
      line-height: 1.06;
      letter-spacing: -0.025em;
      margin: 0 0 18px;
      max-width: 20ch;
    }
    .dek {
      font-family: var(--serif);
      font-size: clamp(1.15rem, 2.2vw, 1.4rem);
      line-height: 1.5;
      color: var(--body);
      max-width: 58ch;
      margin: 0 0 20px;
    }
    .byline {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 18px;
      margin: 0;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--muted);
    }
    .byline span + span::before {
      content: '·';
      margin-right: 18px;
      color: var(--rule-strong);
    }

    .post-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      margin-top: 44px;
    }
    @media (min-width: 1040px) {
      .post-layout {
        grid-template-columns: minmax(0, 780px) 230px;
        justify-content: space-between;
      }
    }
    .post-main {
      min-width: 0;
    }

    /* Flagship opening */
    .opening {
      margin-bottom: 40px;
    }
    .opening p {
      font-family: var(--serif);
      font-size: 1.22rem;
      line-height: 1.7;
      color: var(--ink);
      margin: 0 0 1.1em;
    }
    .opening .opening-lede::first-letter {
      font-size: 3.6em;
      float: left;
      line-height: 0.86;
      padding: 6px 10px 0 0;
      color: var(--accent);
      font-weight: 700;
    }
    .pull {
      margin: 1.6em 0 0;
      padding: 8px 0 8px 24px;
      border-left: 5px solid var(--accent);
      font-family: var(--serif);
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      line-height: 1.3;
      font-weight: 600;
      color: var(--ink);
    }

    /* One-minute briefing */
    .briefing {
      background: var(--surface);
      border: 1px solid var(--rule);
      border-top: 4px solid var(--accent);
      border-radius: var(--radius);
      padding: 22px 26px 8px;
      margin-bottom: 36px;
      box-shadow: var(--shadow);
    }
    .briefing-title {
      font-family: var(--sans);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--accent);
      margin: 0 0 14px;
    }
    .briefing dl {
      margin: 0;
    }
    .brief-row {
      display: grid;
      grid-template-columns: 170px 1fr;
      gap: 16px;
      padding: 12px 0;
      border-top: 1px solid var(--rule);
    }
    .brief-row:first-child {
      border-top: none;
      padding-top: 0;
    }
    .brief-row dt {
      font-size: 12.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      padding-top: 3px;
    }
    .brief-row dd {
      margin: 0;
      color: var(--ink);
      font-size: 16px;
      line-height: 1.55;
    }

    /* Contents */
    .toc-mobile {
      display: block;
      margin-bottom: 28px;
      border: 1px solid var(--rule);
      border-radius: 10px;
      background: var(--surface);
      padding: 4px 16px;
    }
    .toc-mobile summary {
      cursor: pointer;
      font-weight: 700;
      padding: 11px 0;
    }
    .toc-mobile ol {
      margin: 0 0 12px;
      padding-left: 20px;
    }
    .toc-mobile li {
      margin: 6px 0;
    }
    @media (min-width: 1040px) {
      .toc-mobile {
        display: none;
      }
    }
    .toc-desktop {
      display: none;
    }
    @media (min-width: 1040px) {
      .toc-desktop {
        display: block;
      }
      .toc-desktop nav {
        position: sticky;
        top: 92px;
        padding-left: 20px;
        border-left: 1px solid var(--rule-strong);
      }
    }
    .toc-head {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-weight: 700;
      color: var(--muted);
      margin: 0 0 12px;
    }
    .toc-desktop ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .toc-desktop li {
      margin: 0 0 9px;
      font-size: 14px;
      line-height: 1.4;
    }
    .toc-desktop a {
      color: var(--body);
    }
    .toc-desktop a:hover {
      color: var(--accent-deep);
      text-decoration: none;
    }

    .story :global(h1:first-of-type) {
      display: none;
    }

    /* Runbook */
    .runbook {
      margin-top: 72px;
      padding-top: 8px;
      scroll-margin-top: 90px;
    }
    .runbook-intro {
      background: var(--navy);
      color: #d5dcec;
      border-radius: var(--radius) var(--radius) 0 0;
      padding: 30px 32px 26px;
    }
    .runbook-intro .kicker {
      color: #ffb98f;
    }
    .runbook-intro h2 {
      color: #fff;
      font-size: clamp(1.7rem, 3.4vw, 2.3rem);
      margin: 0 0 10px;
    }
    .runbook-intro p:last-child {
      margin: 0;
      max-width: 60ch;
      line-height: 1.6;
    }
    .runbook-toggle {
      border: 1px solid var(--navy);
      border-top: none;
      border-radius: 0 0 var(--radius) var(--radius);
      background: var(--surface);
      overflow: hidden;
    }
    .runbook-toggle > summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 18px 32px;
      background: var(--accent-soft);
    }
    .runbook-toggle > summary::-webkit-details-marker {
      display: none;
    }
    .rb-title {
      font-weight: 700;
      color: var(--accent-deep);
      font-size: 1.05rem;
    }
    .rb-title::before {
      content: '+ ';
    }
    .runbook-toggle[open] .rb-title::before {
      content: '\2212  ';
    }
    .rb-sub {
      font-size: 14px;
      color: var(--muted);
    }
    .runbook-body {
      padding: 12px 32px 32px;
    }
    .runbook-body .prose h2 {
      font-size: 1.6rem;
    }

    .artifact {
      margin-top: 40px;
      padding-top: 26px;
      border-top: 1px solid var(--rule);
      scroll-margin-top: 90px;
    }
    .artifact h3 {
      font-size: 1.5rem;
      margin: 0 0 6px;
    }
    .artifact-note {
      color: var(--muted);
      font-size: 14.5px;
      margin: 0 0 16px;
    }
    .script,
    .longform {
      border: 1px solid var(--rule);
      border-radius: 10px;
      margin-bottom: 12px;
      background: var(--surface);
      overflow: hidden;
    }
    .script > summary,
    .longform > summary {
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      font-weight: 600;
      list-style: none;
    }
    .script > summary::-webkit-details-marker,
    .longform > summary::-webkit-details-marker {
      display: none;
    }
    .script > summary::before,
    .longform > summary::before {
      content: '▸';
      color: var(--muted);
      font-size: 12px;
      margin-right: 2px;
    }
    .script[open] > summary::before,
    .longform[open] > summary::before {
      content: '▾';
    }
    .script-file {
      font-family: var(--mono);
      font-size: 13.5px;
      color: var(--ink);
      flex: 1;
      overflow-wrap: anywhere;
    }
    .script-lang {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      background: var(--tint);
      border-radius: 999px;
      padding: 2px 9px;
      flex: none;
    }
    .script-body {
      position: relative;
      border-top: 1px solid var(--rule);
    }
    .script-body :global(pre) {
      margin: 0;
      border: none;
      border-radius: 0;
      padding: 16px 18px;
      max-height: 520px;
    }
    .copy-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 2;
      font: inherit;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--ink);
      background: var(--surface);
      border: 1px solid var(--rule-strong);
      border-radius: 7px;
      padding: 5px 11px;
      cursor: pointer;
    }
    .copy-btn:hover {
      border-color: var(--accent);
      color: var(--accent-deep);
    }
    .copy-btn.copied {
      color: #0a7f3f;
      border-color: #0a7f3f;
    }
    .longform > summary {
      color: var(--accent-deep);
    }
    .longform .prose {
      padding: 4px 20px 20px;
    }

    /* Keep reading */
    .keep {
      margin-top: 80px;
      padding-top: 34px;
      border-top: 2px solid var(--ink);
    }
    .keep h2 {
      font-size: clamp(1.5rem, 3vw, 2rem);
      margin: 0 0 22px;
    }
    .keep-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .keep-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 20px;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 12px;
      color: var(--ink);
      transition:
        transform 0.16s ease,
        box-shadow 0.16s ease;
    }
    .keep-card:hover {
      text-decoration: none;
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
    .keep-title {
      font-family: var(--serif);
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1.25;
    }
    .keep-text {
      font-size: 14px;
      line-height: 1.55;
      color: var(--body);
    }
    .keep-meta {
      margin-top: auto;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--muted);
    }

    @media (max-width: 760px) {
      .brief-row {
        grid-template-columns: 1fr;
        gap: 4px;
      }
      .keep-grid {
        grid-template-columns: 1fr;
      }
      .runbook-intro,
      .runbook-body {
        padding-left: 20px;
        padding-right: 20px;
      }
      .runbook-toggle > summary {
        padding: 16px 20px;
      }
    }
  </style>
</Base>
