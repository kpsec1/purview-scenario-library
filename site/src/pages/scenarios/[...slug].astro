---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const isOverview = (e: { id: string }) => !e.id.split('/').pop()!.includes('.');
  const all = await getCollection('scenarios');
  const overviews = all.filter(isOverview);

  const partsByParent = new Map<string, Record<string, (typeof all)[number]>>();
  for (const e of all) {
    if (e.data.part && e.data.parent) {
      const bucket = partsByParent.get(e.data.parent) ?? {};
      bucket[e.data.part] = e;
      partsByParent.set(e.data.parent, bucket);
    }
  }

  return overviews.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      parts: partsByParent.get(entry.id) ?? {},
    },
  }));
}

const { entry, parts } = Astro.props;
const data = entry.data;

// Render overview + each available lifecycle part.
const { Content: OverviewContent } = await render(entry);
const partOrder = ['design', 'deploy', 'validate', 'rollback'] as const;
const renderedParts: Record<string, any> = {};
for (const key of partOrder) {
  if (parts[key]) renderedParts[key] = (await render(parts[key])).Content;
}

const STEP_META: Record<string, { label: string; blurb: string }> = {
  overview: { label: 'Overview', blurb: 'What it does and why' },
  design: { label: 'Design', blurb: 'Architecture & decisions' },
  deploy: { label: 'Deploy', blurb: 'Scripts to roll it out' },
  validate: { label: 'Validate', blurb: 'Confirm it works' },
  rollback: { label: 'Rollback', blurb: 'Undo safely' },
};

const steps = ['overview', ...partOrder.filter((p) => parts[p])];
const badge: Record<string, number | undefined> = {
  deploy: data.deployCount,
  validate: data.validateCount,
};
---

<Base title={`${data.title} · ${data.category}`} description={`${data.fullTitle} — deploy, validate, and roll back on-site.`}>
  <div class="scenario-header">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/scenarios/">Library</a>
        <span>/</span>
        <a href={`/scenarios/#${data.categorySlug}`}>{data.category}</a>
      </nav>
      <p class="area-tag">{data.category}</p>
      <h1>{data.fullTitle}</h1>
    </div>
  </div>

  <div class="wrap">
    <!-- Lifecycle stepper doubles as the tab bar -->
    <nav class="stepper" role="tablist" aria-label="Scenario lifecycle">
      {
        steps.map((step, i) => (
          <button
            class:list={['step', { active: i === 0 }]}
            role="tab"
            id={`tab-${step}`}
            aria-controls={`panel-${step}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-step={step}
          >
            <span class="step-num">{i + 1}</span>
            <span class="step-text">
              <span class="step-label">
                {STEP_META[step].label}
                {badge[step] ? <span class="step-badge">{badge[step]}</span> : null}
              </span>
              <span class="step-blurb">{STEP_META[step].blurb}</span>
            </span>
          </button>
        ))
      }
    </nav>

    <div class="panels">
      <section class="panel prose active" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview">
        <OverviewContent />
      </section>
      {
        partOrder
          .filter((p) => parts[p])
          .map((p) => {
            const PartContent = renderedParts[p];
            return (
              <section class="panel prose" id={`panel-${p}`} role="tabpanel" aria-labelledby={`tab-${p}`}>
                <PartContent />
              </section>
            );
          })
      }
    </div>

  </div>

  <script>
    // Tabbed lifecycle: show one panel at a time, deep-link via hash.
    const tablist = document.querySelector('.stepper');
    const panelsWrap = document.querySelector('.panels');
    if (tablist && panelsWrap) {
      panelsWrap.classList.add('tabbed');
      const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('.step'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

      function activate(step: string, push = true) {
        let matched = false;
        for (const tab of tabs) {
          const on = tab.dataset.step === step;
          tab.classList.toggle('active', on);
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          if (on) matched = true;
        }
        for (const panel of panels) {
          panel.classList.toggle('active', panel.id === `panel-${step}`);
        }
        if (matched && push && history.replaceState) {
          history.replaceState(null, '', `#${step}`);
        }
      }

      tabs.forEach((tab) =>
        tab.addEventListener('click', () => activate(tab.dataset.step as string))
      );

      const initial = location.hash.replace('#', '');
      if (initial && tabs.some((t) => t.dataset.step === initial)) activate(initial, false);
    }
  </script>

  <style>
    .scenario-header {
      background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
      border-bottom: 1px solid var(--border);
      padding: 34px 0 28px;
      margin-bottom: 28px;
    }
    .crumbs {
      font-size: 13.5px;
      color: var(--muted);
      margin-bottom: 14px;
    }
    .crumbs span {
      margin: 0 7px;
      color: var(--border-strong);
    }
    .area-tag {
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--accent);
      background: var(--bg-tint);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px 10px;
      margin: 0 0 12px;
    }
    h1 {
      font-size: clamp(1.7rem, 4vw, 2.3rem);
      margin: 0;
      max-width: 26ch;
    }

    /* Lifecycle stepper / tabs */
    .stepper {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 8px;
      margin-bottom: 28px;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .step {
      display: flex;
      align-items: center;
      gap: 11px;
      text-align: left;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #fff;
      color: var(--ink);
      cursor: pointer;
      font: inherit;
      min-width: 150px;
      transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease,
        background 0.15s ease;
    }
    .step:hover {
      border-color: var(--accent);
    }
    .step.active {
      border-color: var(--accent);
      background: var(--accent);
      box-shadow: 0 6px 16px rgba(29, 78, 216, 0.24);
    }
    .step.active .step-label,
    .step.active .step-blurb {
      color: #fff;
    }
    .step.active .step-num {
      background: #fff;
      color: var(--accent-ink);
    }
    .step-num {
      flex: none;
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--bg-tint);
      color: var(--accent-ink);
      font-weight: 800;
      font-size: 13px;
    }
    .step-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }
    .step-label {
      font-weight: 700;
      font-size: 14.5px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .step-badge {
      background: var(--bg-tint);
      color: var(--accent-ink);
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      padding: 0 6px;
      min-width: 18px;
      text-align: center;
    }
    .step.active .step-badge {
      background: rgba(255, 255, 255, 0.25);
      color: #fff;
    }
    .step-blurb {
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    /* Panels: when tabbed, stack and show one; without JS, show all */
    .panels {
      position: relative;
    }
    .panels.tabbed .panel {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      /* visibility (not display:none) so Mermaid can still measure diagrams */
      visibility: hidden;
      pointer-events: none;
    }
    .panels.tabbed .panel.active {
      position: relative;
      visibility: visible;
      pointer-events: auto;
    }
    .panels:not(.tabbed) .panel + .panel {
      margin-top: 40px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }

    .prose :global(h1:first-of-type) {
      display: none;
    }

    @media (max-width: 640px) {
      .stepper {
        grid-auto-flow: row;
        grid-auto-columns: unset;
      }
    }
  </style>
</Base>
