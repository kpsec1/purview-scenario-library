---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Code } from 'astro:components';

// Structured deploy/validate scripts, generated by sync-scenarios.mjs.
const scriptModules = import.meta.glob('/src/data/scenario-scripts/**/*.json', { eager: true });
const scriptsById: Record<string, { deploy: Script[]; validate: Script[] }> = {};
for (const [file, mod] of Object.entries(scriptModules)) {
  const id = file.replace('/src/data/scenario-scripts/', '').replace(/\.json$/, '');
  scriptsById[id] = (mod as any).default ?? mod;
}

interface Script {
  path: string;
  lang: string;
  code: string;
}

export async function getStaticPaths() {
  const isOverview = (e: { id: string }) => !e.id.split('/').pop()!.includes('.');
  const all = await getCollection('scenarios');
  const partsByParent = new Map<string, Record<string, (typeof all)[number]>>();
  for (const e of all) {
    if (e.data.part && e.data.parent) {
      const bucket = partsByParent.get(e.data.parent) ?? {};
      bucket[e.data.part] = e;
      partsByParent.set(e.data.parent, bucket);
    }
  }
  return all.filter(isOverview).map((entry) => ({
    params: { slug: entry.id },
    props: { entry, parts: partsByParent.get(entry.id) ?? {} },
  }));
}

const { entry, parts } = Astro.props;
const data = entry.data;
const { Content: OverviewContent } = await render(entry);
const DesignContent = parts.design ? (await render(parts.design)).Content : null;
const RollbackContent = parts.rollback ? (await render(parts.rollback)).Content : null;

const scripts = scriptsById[entry.id] ?? { deploy: [], validate: [] };
const shikiLang = (l: string) => (l === 'text' ? 'plaintext' : l);

// Contents list: README sections plus the artifact sections that exist.
const toc = [...(data.toc ?? [])];
if (scripts.deploy.length) toc.push({ id: 'deployment-scripts', text: 'Deployment scripts' });
if (scripts.validate.length) toc.push({ id: 'validation-scripts', text: 'Validation scripts' });
if (data.hasDesign) toc.push({ id: 'design-notes', text: 'Design notes' });
if (data.hasRollback) toc.push({ id: 'rollback-runbook', text: 'Rollback runbook' });

// At a glance facts (only those we can derive reliably).
const facts: { label: string; value: string }[] = [];
if (data.category) facts.push({ label: 'Solution area', value: data.category });
if (data.deployCount) facts.push({ label: 'Deployment', value: `${data.deployCount} script${data.deployCount === 1 ? '' : 's'}` });
if (data.validateCount) facts.push({ label: 'Validation', value: `${data.validateCount} script${data.validateCount === 1 ? '' : 's'}` });
if (data.hasRollback) facts.push({ label: 'Reversible', value: 'Yes, rollback provided' });
if (data.frameworks && data.frameworks.length) facts.push({ label: 'Frameworks referenced', value: data.frameworks.join(', ') });
if (data.licensing && data.licensing.length) facts.push({ label: 'Licensing referenced', value: data.licensing.join(', ') });
---

<Base title={`${data.title} · ${data.category}`} description={data.whoFor ?? data.title}>
  <div class="scenario-header">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/scenarios/">Library</a>
        <span>/</span>
        <a href={`/scenarios/#${data.categorySlug}`}>{data.category}</a>
      </nav>
      <p class="area-tag">{data.category}</p>
      <h1>{data.title}</h1>
      {data.whoFor && <p class="who">{data.whoFor}</p>}
    </div>
  </div>

  <div class="scenario-layout">
    <main class="scenario-main">
      {
        facts.length > 0 && (
          <section class="glance" aria-label="At a glance">
            <h2 class="glance-title">At a glance</h2>
            <dl class="glance-grid">
              {facts.map((f) => (
                <div class="glance-item">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <details class="toc-mobile">
        <summary>Contents</summary>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
        </ol>
      </details>

      <article class="prose">
        <OverviewContent />
      </article>

      {
        scripts.deploy.length > 0 && (
          <section class="artifact" id="deployment-scripts">
            <h2>Deployment scripts</h2>
            <p class="artifact-note">
              {scripts.deploy.length} file{scripts.deploy.length === 1 ? '' : 's'}. Review each, then
              run in order. Expand to read; use Copy to grab the full script.
            </p>
            {scripts.deploy.map((s) => (
              <details class="script">
                <summary>
                  <span class="script-file">{s.path}</span>
                  <span class="script-lang">{s.lang}</span>
                </summary>
                <div class="script-body">
                  <button class="copy-btn" type="button">Copy</button>
                  <Code code={s.code} lang={shikiLang(s.lang) as any} theme="github-light" />
                </div>
              </details>
            ))}
          </section>
        )
      }

      {
        scripts.validate.length > 0 && (
          <section class="artifact" id="validation-scripts">
            <h2>Validation scripts</h2>
            <p class="artifact-note">
              Run these after deployment to confirm the control works as designed.
            </p>
            {scripts.validate.map((s) => (
              <details class="script">
                <summary>
                  <span class="script-file">{s.path}</span>
                  <span class="script-lang">{s.lang}</span>
                </summary>
                <div class="script-body">
                  <button class="copy-btn" type="button">Copy</button>
                  <Code code={s.code} lang={shikiLang(s.lang) as any} theme="github-light" />
                </div>
              </details>
            ))}
          </section>
        )
      }

      {
        DesignContent && (
          <section class="artifact" id="design-notes">
            <h2>Design notes</h2>
            <details class="longform">
              <summary>Read the design notes</summary>
              <div class="prose"><DesignContent /></div>
            </details>
          </section>
        )
      }

      {
        RollbackContent && (
          <section class="artifact" id="rollback-runbook">
            <h2>Rollback runbook</h2>
            <details class="longform">
              <summary>Read the rollback runbook</summary>
              <div class="prose"><RollbackContent /></div>
            </details>
          </section>
        )
      }
    </main>

    <aside class="toc-desktop" aria-label="Contents">
      <nav>
        <p class="toc-head">On this page</p>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
        </ol>
      </nav>
    </aside>
  </div>

  <script>
    // Copy buttons on script blocks.
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const pre = btn.parentElement?.querySelector('pre');
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.innerText);
          const prev = btn.textContent;
          btn.textContent = 'Copied';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = prev;
            btn.classList.remove('copied');
          }, 1400);
        } catch {
          btn.textContent = 'Copy failed';
          setTimeout(() => (btn.textContent = 'Copy'), 1400);
        }
      });
    });
  </script>

  <style>
    .scenario-header {
      background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
      border-bottom: 1px solid var(--border);
      padding: 34px 0 28px;
      margin-bottom: 32px;
    }
    .crumbs {
      font-size: 13.5px;
      color: var(--muted);
      margin-bottom: 14px;
    }
    .crumbs span {
      margin: 0 7px;
      color: var(--border-strong);
    }
    .area-tag {
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--accent);
      background: var(--bg-tint);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px 10px;
      margin: 0 0 12px;
    }
    .scenario-header h1 {
      font-size: clamp(1.7rem, 4vw, 2.3rem);
      margin: 0;
      max-width: 28ch;
    }
    .who {
      margin: 14px 0 0;
      color: var(--body);
      font-size: 1.05rem;
      max-width: 70ch;
    }

    .scenario-layout {
      width: 100%;
      max-width: 1160px;
      margin: 0 auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
    }
    @media (min-width: 1000px) {
      .scenario-layout {
        grid-template-columns: minmax(0, 1fr) 236px;
      }
    }
    .scenario-main {
      min-width: 0;
    }

    /* At a glance */
    .glance {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px 24px;
      margin-bottom: 32px;
    }
    .glance-title {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin: 0 0 16px;
    }
    .glance-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px 24px;
      margin: 0;
    }
    .glance-item dt {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent);
      margin-bottom: 3px;
    }
    .glance-item dd {
      margin: 0;
      color: var(--ink);
      font-weight: 500;
    }

    /* Contents (mobile) */
    .toc-mobile {
      display: block;
      margin-bottom: 28px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      padding: 4px 14px;
    }
    .toc-mobile summary {
      cursor: pointer;
      font-weight: 700;
      padding: 10px 0;
    }
    .toc-mobile ol {
      margin: 0 0 12px;
      padding-left: 20px;
      color: var(--body);
    }
    .toc-mobile li {
      margin: 5px 0;
    }
    @media (min-width: 1000px) {
      .toc-mobile {
        display: none;
      }
    }

    /* Contents (desktop sidebar) */
    .toc-desktop {
      display: none;
    }
    @media (min-width: 1000px) {
      .toc-desktop {
        display: block;
      }
      .toc-desktop nav {
        position: sticky;
        top: 84px;
        border-left: 1px solid var(--border);
        padding-left: 18px;
      }
    }
    .toc-head {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      font-weight: 700;
      margin: 0 0 10px;
    }
    .toc-desktop ol {
      list-style: none;
      margin: 0;
      padding: 0;
      counter-reset: toc;
    }
    .toc-desktop li {
      margin: 0 0 8px;
      font-size: 13.5px;
      line-height: 1.35;
    }
    .toc-desktop a {
      color: var(--body);
    }
    .toc-desktop a:hover {
      color: var(--accent);
      text-decoration: none;
    }

    /* Artifact sections */
    .artifact {
      margin-top: 44px;
      padding-top: 28px;
      border-top: 1px solid var(--border);
      scroll-margin-top: 80px;
    }
    .artifact > h2 {
      font-size: 1.4rem;
      margin: 0 0 6px;
    }
    .artifact-note {
      color: var(--muted);
      font-size: 14.5px;
      margin: 0 0 18px;
    }

    .script,
    .longform {
      border: 1px solid var(--border);
      border-radius: 10px;
      margin-bottom: 12px;
      background: #fff;
      overflow: hidden;
    }
    .script > summary,
    .longform > summary {
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      font-weight: 600;
      list-style: none;
    }
    .script > summary::-webkit-details-marker,
    .longform > summary::-webkit-details-marker {
      display: none;
    }
    .script > summary::before,
    .longform > summary::before {
      content: '▸';
      color: var(--muted);
      font-size: 12px;
      margin-right: 2px;
    }
    .script[open] > summary::before,
    .longform[open] > summary::before {
      content: '▾';
    }
    .script-file {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 13.5px;
      color: var(--ink);
      flex: 1;
      overflow-wrap: anywhere;
    }
    .script-lang {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      background: var(--bg-tint);
      border-radius: 999px;
      padding: 2px 9px;
      flex: none;
    }
    .script-body {
      position: relative;
      border-top: 1px solid var(--border);
    }
    .script-body :global(pre) {
      margin: 0;
      border: none;
      border-radius: 0;
      padding: 16px 18px;
      max-height: 520px;
    }
    .copy-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 2;
      font: inherit;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--ink);
      background: #fff;
      border: 1px solid var(--border-strong);
      border-radius: 7px;
      padding: 5px 11px;
      cursor: pointer;
    }
    .copy-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .copy-btn.copied {
      color: #0a7f3f;
      border-color: #0a7f3f;
    }
    .longform > summary {
      color: var(--accent);
    }
    .longform .prose {
      padding: 4px 18px 18px;
    }

    .prose :global(h1:first-of-type) {
      display: none;
    }
  </style>
</Base>
